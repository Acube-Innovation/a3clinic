# Copy to .env.local and fill in. AUTH_SECRET: openssl rand -hex 32
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=
# Set to "true" when the site is served over HTTPS (required for real deployments).
ADMIN_COOKIE_SECURE=

# MySQL/MariaDB content store (AWS RDS in production). When these are unset,
# the app falls back to the /content JSON file store.
# After first setup, load existing content with: npm run db:migrate-content
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=a3clinic
